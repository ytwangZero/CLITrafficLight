{
  "version": 1,
  "author": "codex-light",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-v1", "id": "esp", "top": 0, "left": -50, "attrs": {} },
    { "type": "wokwi-led", "id": "led_red", "top": -40, "left": 260, "attrs": { "color": "red" } },
    { "type": "wokwi-led", "id": "led_yellow", "top": 20, "left": 260, "attrs": { "color": "yellow" } },
    { "type": "wokwi-led", "id": "led_green", "top": 80, "left": 260, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r_red", "top": -40, "left": 200, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_yellow", "top": 20, "left": 200, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_green", "top": 80, "left": 200, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 140, "left": 260, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:D25", "r_red:1", "green", [] ],
    [ "r_red:2", "led_red:A", "green", [] ],
    [ "led_red:C", "esp:GND.1", "black", [] ],

    [ "esp:D26", "r_yellow:1", "green", [] ],
    [ "r_yellow:2", "led_yellow:A", "green", [] ],
    [ "led_yellow:C", "esp:GND.1", "black", [] ],

    [ "esp:D27", "r_green:1", "green", [] ],
    [ "r_green:2", "led_green:A", "green", [] ],
    [ "led_green:C", "esp:GND.1", "black", [] ],

    [ "esp:D14", "buzzer:1", "green", [] ],
    [ "buzzer:2", "esp:GND.1", "black", [] ],

    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ]
  ],
  "serialMonitor": {
    "display": "always"
  }
}
